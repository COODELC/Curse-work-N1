<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ktpt.CourseOrder.Views.CartWindow"
        Title="Корзина"
        Width="700"
        Height="560"
        Background="{DynamicResource PageBackgroundBrush}">

	<Grid RowDefinitions="Auto,*,Auto" Margin="24">

		<Border Grid.Row="0"
                Background="{DynamicResource HeaderGradientBrush}"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,16">

			<TextBlock Text="Корзина"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF" />

		</Border>

		<ListBox Grid.Row="1"
                 ItemsSource="{Binding Cart}"
                 Background="Transparent"
                 BorderThickness="0">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Padding="14"
                            Margin="0,0,0,10"
                            CornerRadius="10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">

						<Grid ColumnDefinitions="*,Auto,Auto">

							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="{Binding Name_Item}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

								<TextBlock Text="{Binding Price, StringFormat='Цена: {0:N2} руб.'}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

								<TextBlock Text="{Binding Total, StringFormat='Сумма: {0:N2} руб.'}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
							</StackPanel>

							<StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">

								<Button Content="−"
                                        Command="{Binding $parent[Window].DataContext.DecreaseCommand}"
                                        CommandParameter="{Binding}" />

								<TextBlock Text="{Binding Quantity, StringFormat='x{0}'}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

								<Button Content="+"
                                        Command="{Binding $parent[Window].DataContext.IncreaseCommand}"
                                        CommandParameter="{Binding}" />

							</StackPanel>

							<Button Grid.Column="2"
                                    Content="Удалить"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding $parent[Window].DataContext.RemoveFromCartCommand}"
                                    CommandParameter="{Binding}" />

						</Grid>

					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

		<StackPanel Grid.Row="2" Spacing="12">

			<TextBlock Text="{Binding CartTotal, StringFormat='Итого: {0:N2} руб.'}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

			<Button Content="Оплатить"
                    Height="44"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    Command="{Binding PayCommand}" />

			<TextBlock Text="{Binding PaymentStatus}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

		</StackPanel>

	</Grid>

</Window>
