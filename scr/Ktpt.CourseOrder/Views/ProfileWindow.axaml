<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ktpt.CourseOrder.Views.ProfileWindow"
        Title="Профиль"
        Width="480"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Border Margin="24"
            Padding="24"
            CornerRadius="16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <StackPanel Spacing="14">

            <TextBlock Text="Профиль пользователя"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Имя" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding FirstName}" FontSize="17" FontWeight="SemiBold" />

                <TextBlock Text="Фамилия" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding SecondName}" FontSize="17" />

                <TextBlock Text="Возраст" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding AgeText}" FontSize="17" />

                <TextBlock Text="Логин" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding Login}" FontSize="17" />

                <TextBlock Text="Роль" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding RoleName}" FontSize="17" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>

            <Button Content="Закрыть"
                    HorizontalAlignment="Right"
                    Click="Close_Click" />

        </StackPanel>
    </Border>
</Window>
