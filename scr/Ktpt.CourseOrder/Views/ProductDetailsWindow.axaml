<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Ktpt.CourseOrder.Views.ProductDetailsWindow"
        Title="О товаре"
        Width="640"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Spacing="8">

            <TextBlock Text="Информация о товаре"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Text="{Binding Name_Item}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Фотография товара из папки Assets -->
            <Border Height="200"
                    Margin="0,8,0,0"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Background="#F1F5F9">

                <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />

            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">

                <TextBlock Text="{Binding Name_Category}" />

                <TextBlock Text="•" />

                <TextBlock Text="{Binding PriceText}" />

                <TextBlock Text="•" />

                <TextBlock Text="{Binding QuantityText}" />

            </StackPanel>

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,16"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="16">

                <TextBlock Text="Описание"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           Text="{Binding Description}" />

                <TextBlock Text="Артикул"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding NameArticule}"
                           TextWrapping="Wrap" />

            </StackPanel>

        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Закрыть"
                HorizontalAlignment="Right"
                MinWidth="120"
                Click="Close_Click" />

    </Grid>

</Window>