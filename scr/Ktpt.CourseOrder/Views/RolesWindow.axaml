<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ktpt.CourseOrder.Views.RolesWindow"
        Title="Управление ролями"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid RowDefinitions="Auto,*"
          Margin="24">

        <TextBlock Grid.Row="0"
                   Text="Управление ролями пользователей"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Users}"
                 Background="Transparent"
                 BorderThickness="0">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            CornerRadius="12"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">

                        <Grid ColumnDefinitions="*,Auto,Auto">

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <TextBlock Text="{Binding Login}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      MinWidth="170"
                                      Margin="0,0,10,0"
                                      ItemsSource="{Binding $parent[Window].DataContext.Roles}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}" />

                            <Button Grid.Column="2"
                                    Classes="accent"
                                    Content="Сохранить"
                                    Command="{Binding $parent[Window].DataContext.SaveRoleCommand}"
                                    CommandParameter="{Binding}" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>
</Window>
