<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ktpt.CourseOrder.Views.ReviewsWindow"
        Title="Отзывы о товаре"
        Width="640"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

	<Grid RowDefinitions="Auto,*,Auto" Margin="24">

		<!-- Заголовок -->
		<StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16">

			<Border Background="{DynamicResource HeaderGradientBrush}"
                    CornerRadius="14"
                    Padding="20,16">

				<TextBlock x:Name="CaptionText"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="#FFFFFF" />

			</Border>

			<TextBlock x:Name="CountText"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

		</StackPanel>

		<!-- Список отзывов -->
		<Panel Grid.Row="1">

			<ListBox x:Name="ReviewsList"
                     Background="Transparent"
                     BorderThickness="0">

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Padding="14"
                                Margin="0,0,0,10"
                                CornerRadius="10"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">

							<StackPanel Spacing="6">

								<!-- Автор отзыва -->
								<StackPanel Orientation="Horizontal" Spacing="8">

									<Border Padding="10,4"
									        CornerRadius="7"
									        Background="{DynamicResource AccentBrush}">

										<TextBlock Text="{Binding Author}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />

									</Border>

									<TextBlock Text="{Binding AuthorRoleText}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />

								</StackPanel>

								<!-- Текст отзыва -->
								<TextBlock Text="{Binding Text}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>

			<TextBlock x:Name="EmptyText"
                       IsVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="15"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

		</Panel>

		<!-- Кнопка закрытия -->
		<Button Grid.Row="2"
                Content="Закрыть"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="CloseButton_Click" />

	</Grid>

</Window>
