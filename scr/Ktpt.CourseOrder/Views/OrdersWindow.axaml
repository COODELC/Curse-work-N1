<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ktpt.CourseOrder.Views.OrdersWindow"
        Title="Мои заказы"
        Width="860"
        Height="560"
        Background="{DynamicResource PageBackgroundBrush}">

	<Grid RowDefinitions="Auto,Auto,*" Margin="24">

		<Border Grid.Row="0"
                Background="{DynamicResource HeaderGradientBrush}"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,12">

			<TextBlock Text="История покупок"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF" />

		</Border>

		<TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

		<ListBox Grid.Row="2"
                 ItemsSource="{Binding Orders}"
                 Background="Transparent"
                 BorderThickness="0">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Padding="14"
                            Margin="0,0,0,10"
                            CornerRadius="10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">

						<Grid ColumnDefinitions="*,Auto">

							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="{Binding ItemName}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

								<TextBlock Text="{Binding Date, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

								<TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

								<!-- Цветная плашка статуса -->
								<Border Padding="10,4"
                                        CornerRadius="7"
                                        HorizontalAlignment="Left"
                                        Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">

									<TextBlock Text="{Binding Status}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF" />

								</Border>

								<TextBlock Text="{Binding Price, StringFormat='Сумма: {0:N2} руб.'}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
							</StackPanel>

							<Button Grid.Column="1"
                                    Content="Отменить"
                                    VerticalAlignment="Center"
                                    Command="{Binding $parent[Window].DataContext.CancelCommand}"
                                    CommandParameter="{Binding}" />

						</Grid>

					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

	</Grid>

</Window>
