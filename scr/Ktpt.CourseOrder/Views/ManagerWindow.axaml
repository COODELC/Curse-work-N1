<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ktpt.CourseOrder.Views.ManagerWindow"
        Title="Обработка заказов"
        Width="1000"
        Height="620"
        Background="{DynamicResource PageBackgroundBrush}">

	<Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

		<Border Grid.Row="0"
                Background="{DynamicResource HeaderGradientBrush}"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,12">

			<TextBlock Text="Обработка заказов"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF" />

		</Border>

		<Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">

			<TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">

				<ComboBox MinWidth="200"
                          PlaceholderText="Статус заказа"
                          ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding SelectedStatus}" />

				<Button Content="Сменить статус"
                        Command="{Binding ChangeStatusCommand}" />

			</StackPanel>

		</Grid>

		<Border Grid.Row="2"
                Padding="12"
                Margin="0,0,0,16"
                CornerRadius="10"
                Background="{DynamicResource InfoBackgroundBrush}"
                BorderBrush="{DynamicResource InfoBorderBrush}"
                BorderThickness="1">
			<TextBlock Text="Выберите заказ в списке, укажите новый статус и нажмите «Сменить статус». Кнопка «Отменить» возвращает товар на склад."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
		</Border>

		<ListBox Grid.Row="3"
                 ItemsSource="{Binding Orders}"
                 SelectedItem="{Binding SelectedOrder}"
                 Background="Transparent"
                 BorderThickness="0">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Padding="14"
                            Margin="0,0,0,8"
                            CornerRadius="10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">

						<Grid ColumnDefinitions="Auto,*,Auto,Auto">

							<TextBlock Grid.Column="0"
                                       Text="{Binding Id, StringFormat='№ {0}'}"
                                       FontWeight="Bold"
                                       Width="70"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

							<StackPanel Grid.Column="1" Spacing="3">
								<TextBlock Text="{Binding ItemName}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

								<TextBlock Text="{Binding UserName, StringFormat='Покупатель: {0}'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

								<TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
							</StackPanel>

							<!-- Цветная плашка статуса -->
							<Border Grid.Column="2"
                                    Padding="10,4"
                                    Margin="12,0"
                                    CornerRadius="7"
                                    VerticalAlignment="Center"
                                    Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">

								<TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />

							</Border>

							<Button Grid.Column="3"
                                    Content="Отменить"
                                    VerticalAlignment="Center"
                                    Command="{Binding $parent[Window].DataContext.CancelCommand}"
                                    CommandParameter="{Binding}" />

						</Grid>

					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

	</Grid>

</Window>
