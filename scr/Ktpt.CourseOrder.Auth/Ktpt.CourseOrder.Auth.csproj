    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ktpt.CourseOrder.Auth</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI-фреймворк для окна авторизации -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />

    <!-- Хеширование паролей (Microsoft.AspNetCore.Identity.PasswordHasher) -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общий слой данных: сущности и контекст Entity Framework Core -->
    <ProjectReference Include="..\Ktpt.CourseOrder.Data\Ktpt.CourseOrder.Data.csproj" />
  </ItemGroup>

</Project>
