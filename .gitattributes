# Нормализация переводов строк для проекта Ktpt.CourseOrder
# Код и текст — всегда LF в репозитории, CRLF при проверке в Windows.
# Бинарные файлы (docx, pptx, png, drawio) помечаются как binary,
# чтобы Git не пытался их нормализовать и не ломал структуру архивов.

* text=auto

*.cs       text eol=lf
*.axaml    text eol=lf
*.csproj  text eol=lf
*.sln      text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.ps1      text eol=lf
*.drawio   text eol=lf
*.html     text eol=lf
*.config   text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Бинарные — не трогать
*.docx     binary
*.pptx     binary
*.xlsx     binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.exe      binary
*.dll      binary
*.pdb      binary
*.so       binary
*.dylib    binary
*.ttf      binary
*.woff     binary
*.woff2    binary
